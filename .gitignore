04-android/nowinandroid/release.jks
**/target/

# local run artifacts
*.pid
run*.log

# per-repo logs the benchmark harness writes beside each run (the jsonl rows and RESULTS.md are the record)
bench/maven-top20/results/*/
!bench/maven-top20/results/run1/
!bench/maven-top20/results/run2/
!bench/maven-top20/results/lock-diff/

# graphify output the agent-graph bench writes into the repositories it measures
graphify-out/

# Gradle's own output in the migration recipe, which still builds with Gradle
05-recipes/migrate/from-gradle/**/build/
05-recipes/migrate/from-gradle/.gradle/
