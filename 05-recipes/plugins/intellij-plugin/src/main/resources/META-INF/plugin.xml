<idea-plugin>
    <id>dev.jkexamples.sort-lines</id>
    <name>Sort Lines</name>
    <vendor>jk-examples</vendor>
    <description>Sorts the selected lines, or the whole file when nothing is selected.</description>
    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="dev.jkexamples.SortLines" class="dev.jkexamples.sortlines.SortLinesAction"
                text="Sort Lines" description="Sort the selected lines alphabetically">
            <add-to-group group-id="EditMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift S"/>
        </action>
    </actions>
</idea-plugin>
